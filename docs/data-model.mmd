erDiagram
  TEAMS ||--o{ TRANSACTIONS : executes
  TEAMS ||--o{ BOX_SCORES : "weekly performance"
  TEAMS ||--o{ MATCHUPS : "home team"
  TEAMS ||--o{ MATCHUPS : "away team"
  PLAYERS ||--o{ BOX_SCORES : appears_in
  PLAYERS ||--o{ TRANSACTION_MOVES : "involved in"
