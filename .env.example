# Copy this file to .env and fill in your own values, or run:
#   poetry run python scripts/setup.py
# which writes .env for you interactively.

# --- ESPN league (required) ---
# Find LEAGUE_ID in your league's URL, e.g. ...leagueId=899513
LEAGUE_ID=899513

# Only needed for PRIVATE leagues. Leave blank for public leagues.
# How to get these: log into fantasy.espn.com, open DevTools > Application
# > Cookies > https://fantasy.espn.com, and copy the espn_s2 and SWID values.
ESPN_S2=
SWID=

# --- Chatbot (optional) ---
# Leave blank to run leagueintel without the chatbot feature.
ANTHROPIC_API_KEY=

# default 100000; ~1_800_000 approximates an $8/day budget on claude-sonnet-4-6
# pricing at this app's observed ~88/12 input/output token split
CHATBOT_DAILY_TOKEN_LIMIT=
# dev flag — set false to A/B against caching disabled, see scripts/cache_benchmark.py
ENABLE_PROMPT_CACHING=true

# --- Streamlit app password (optional) ---
LEAGUE_PASSWORD=

# --- Cloud deployment (optional, Streamlit Community Cloud only) ---
# Leave all of these unset for local use — leagueintel runs entirely off
# a local SQLite file without them.
# DB_PATH=/tmp/leagueintel.db
# S3_BUCKET=
# S3_KEY=leagueintel.db
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-west-2
# TURSO_OPS_URL=
# TURSO_OPS_TOKEN=
